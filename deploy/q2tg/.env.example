# ============================================================================
# Q2TG v4 环境变量模板（复制为 /opt/q2tg/.env 后填写；chmod 600）
# 本模板面向 SnowLuma 方案：不需要 icqq / qsign / SIGN_VER
# ============================================================================

# ---------- 必填：Telegram（只能你自己去申请）----------
# https://my.telegram.org/apps  →  api_id / api_hash
TG_API_ID=12345678
TG_API_HASH=0123456789abcdef0123456789abcdef
# @BotFather /newbot  →  token；记得 /setprivacy 关闭 Group Privacy
TG_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxx

# ---------- 必填：数据库密码（自己生成）----------
POSTGRES_DB=q2tg
POSTGRES_USER=q2tg
# 只用字母数字和 _- ，避免拼进 DATABASE_URL 时被 @ : / ? # 截断
# 生成：openssl rand -hex 24
POSTGRES_PASSWORD=换成随机强密码_仅限字母数字下划线中划线

# ---------- 代理：访问 Telegram 用（SOCKS5，可带认证）----------
# 只给 Q2TG 访问 Telegram 用，不要设成服务器全局代理
PROXY_IP=1.2.3.4
PROXY_PORT=1080
PROXY_USERNAME=user
PROXY_PASSWORD=pass

# ---------- 接 SnowLuma 的 OneBot ----------
# 两组 token 从 SnowLuma 的 onebot.json / onebot_<QQ号>.json 里取（HTTP 与 WS 不同）
ONEBOT_WS_TOKEN=换成WS_TOKEN
ONEBOT_HTTP_TOKEN=换成HTTP_TOKEN

# ---------- 服务 ----------
TG_CONNECTION=tcp
TZ=Asia/Shanghai
Q2TG_WEB_PORT=8080
Q2TG_IMAGE=ghcr.io/clansty/q2tg:sleepyfox
POSTGRES_IMAGE=postgres:14-alpine
TG_LOG_LEVEL=info

# ---------- 可选：公网 HTTPS 入口 ----------
# RichHeader 头像、合并转发查看器需要 https://域名 的 Web 入口；只有 IP 无法满足。
# 留空会触发 Invalid URL（坑 8），群消息转发全挂。两档二选一：
# WEB_ENDPOINT=https://你的域名
# WEB_ENDPOINT=http://你的服务器IP:8443
# 合并转发查看器注册成 Telegram WebAPP 后的链接
#CRV_VIEWER_APP=https://t.me/你的机器人/你指定的名字
