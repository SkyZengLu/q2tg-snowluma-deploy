# ============================================================================
# SnowLuma 环境变量模板
# 手写部署：复制为 /opt/snowluma/.env 并 chmod 600
# 用 scripts/install-snowluma.sh 时，脚本会自动生成，无需手动复制本文件
# ============================================================================

TZ=Asia/Shanghai

# 镜像（也可固定为具体 tag，如 v1.10.0）
SNOWLUMA_IMAGE=motricseven7/snowluma:latest
SNOWLUMA_CONTAINER=snowluma

# noVNC 密码。不设则首次启动随机生成，只在容器日志里打印一次（中英文各一行），
# 之后保存在数据卷里，重建容器/升级镜像只要卷还在就不变。
VNC_PASSWD=换成强密码

# 容器内用户 / 数据卷归属（对齐宿主用户 1000，避免权限问题）
SNOWLUMA_UID=1000
SNOWLUMA_GID=1000

# 宿主端口映射（全部只绑 127.0.0.1）
SNOWLUMA_WEBUI_HOST_PORT=5099
NOVNC_PORT=6081
ONEBOT_HTTP_PORT=3000
ONEBOT_WS_PORT=3001

SNOWLUMA_SCREEN=1920x1080x24
SNOWLUMA_LOG_LEVEL=info
